# Copy to .env.local and fill in from Supabase → Project Settings → API
# (On Vercel, the Supabase integration sets these for you.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Needed locally for the AI features (smart fill, cover letters, interview questions).
# On Vercel this is handled automatically.
# AI_GATEWAY_API_KEY=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → "secret" key (or legacy service_role key).
# Only used by the daily job sync to write to the jobs table.
SUPABASE_SECRET_KEY=
# Any long random string. Vercel Cron sends it to /api/cron/sync-jobs automatically.
CRON_SECRET=
